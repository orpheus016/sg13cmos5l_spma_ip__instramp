# ==============================================================================
# Git Ignore Configuration for IHP SG13CMOS5L PGIA IP (slot9_wrapper / pgia_top)
# ==============================================================================

# --- EDA Layout & Physical Verification (KLayout) ---
# Prevent layout auto-backups and temporary run databases from polluting the repo
**/backups/
**/drc_run_*/
**/lvs_run_*/
*.lyrdb
*.lvsdb
*.autosave.gds
*.autosave.oas
*_extracted.cir

# --- Simulation Outputs & CACE Runs (ngspice / CACE) ---
# Large simulation runs, waveforms, and temporary extracted/generated decks
runs/
cace/runs/
cace/**/*.raw

# Temporary xschem simulation spice netlists and logs (xschem .raw files are preserved)
xschem/**/simulations/*.spice
xschem/**/simulations/*.log

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Jupyter Notebooks & Tools ---
.ipynb_checkpoints/

# --- Logs & General Temporary Files ---
*.log
*.tmp
*.bak
*~
*.swp

# --- OS & Editor Configuration ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Local Agent / Context Data ---
contexts/
notebook_references/
