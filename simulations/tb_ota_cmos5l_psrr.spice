** sch_path: /foss/designs/sg13cmos5l_spma_ip__instramp/xschem/ota_cmos5l/tb/tb_ota_cmos5l_psrr/tb_ota_cmos5l_psrr.sch
**.subckt tb_ota_cmos5l_psrr
x1 vss ibias VDD out vinp out ota_cmos5l
C1 out 0 3p
I0 ibias vss 1.4u
V1 VDD vss 1.2
V2 vss 0 0
V3 vinp vss 0.6
**** begin user architecture code



.param temp=27
.param lbias=0.15u wbias=0.15u
.param m6=1 m7=4 m8=8
.param linpair=3u winpair=20u
.param lload=5u wload=10u
.param lcs=3u wcs=20u
.param Cc=2p
.ac dec

.control
save all

** Set sources
alter @V1[AC] = 1

** Simulations
ac dec 100 1 10G

** Plots
setplot ac1
let psrr_db = -db(v(out))
plot psrr_db

** Measurements
meas ac PSRR_gain FIND psrr_db AT=10Hz
let psrr_3db = PSRR_gain + 3
meas ac f_3db WHEN psrr_db=$&psrr_3db

write tb_ota_cmos5l_psrr.raw

.endc
