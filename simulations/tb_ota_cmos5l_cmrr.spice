** sch_path: /foss/designs/sg13cmos5l_spma_ip__instramp/xschem/ota_cmos5l/tb/tb_ota_cmos5l_cmrr/tb_ota_cmos5l_cmrr.sch
**.subckt tb_ota_cmos5l_cmrr
x1 VSS I_B VDD OUT3 VINP3 OUT3 ota_cmos5l
C1 OUT3 0 3p
I0 I_B VSS 1.4u
V1 VDD VSS 1.2
V2 VSS 0 0
V3 VINP3 VSS 0.6
**** begin user architecture code



.lib cornerMOSlv.lib mos_tt
.lib cornerMOShv.lib mos_tt
.lib cornerRES.lib res_typ
.lib cornerDIO.lib dio_tt
.lib cornerCAP.lib cap_typ
.lib cornerMOSCAP.lib moscap_tt




.param temp=27
.param cl=3p
.param ib=1.4u
.param vdd=1.2
.param vicm=vdd/2
.param vid=0




.param temp=27




.control
save all
shell mkdir -p result

* CMRR
alter @v1[acmag]=0
alter @v3[acmag]=1

ac dec 20 1 10G

let v_diff_res = v(VINP3) - v(OUT3)
let cmrr_curve = db(1 / (v_diff_res + 1e-15))

meas ac cmrr_dc find cmrr_curve at=10
meas ac cmrr_100k find cmrr_curve at=100k
meas ac cmrr_1meg find cmrr_curve at=1MEG

write ./result/tb_cg_ota_cmrr.raw v_diff_res cmrr_curve

echo "======================================================="
echo "  CMRR @ DC / 10 Hz        : " $&cmrr_dc   " dB (Target: > 60 dB)"
echo "  CMRR @ 100 kHz           : " $&cmrr_100k " dB"
echo "  CMRR @ 1 MHz             : " $&cmrr_1meg " dB"
echo "======================================================="

plot cmrr_curve xlog
.endc

**** end user architecture code
**.ends

