** sch_path: /foss/designs/Chipalooza/Programmable-Instrumentation-Amplifier-IP/xschem/gain_stage/tb_gain_stage.sch
**.subckt tb_gain_stage
x1 AVDD AVSS IBIAS VIN VCM VOUT s[0] s[1] s[2] s[3] s[4] gain_stage
V_AVDD AVDD 0 1.2
V_AVSS AVSS 0 0
V_VCM VCM 0 0.6
I_BIAS 0 IBIAS 1.0u
V_IN VIN 0 DC 0.6 AC 1m
CL VOUT 0 2p
V_S0 s[0] 0 v_s0
V_S1 s[1] 0 v_s1
V_S2 s[2] 0 v_s2
V_S3 s[3] 0 v_s3
V_S4 s[4] 0 v_s4
**** begin user architecture code


.lib /foss/pdks/ihp-sg13cmos5l/libs.tech/ngspice/models/cornerMOSlv.lib mos_tt
.lib /foss/pdks/ihp-sg13cmos5l/libs.tech/ngspice/models/cornerRES.lib res_typ
.lib /foss/pdks/ihp-sg13cmos5l/libs.tech/ngspice/models/cornerCAP.lib cap_typ
.include /foss/pdks/ihp-sg13cmos5l/libs.ref/sg13cmos5l_stdcell/spice/sg13cmos5l_stdcell.spice




.param v_s0=0 v_s1=0 v_s2=0 v_s3=0 v_s4=0

.control
  save all
  echo ==========================================================================
  echo === GAIN STAGE TAP CHARACTERIZATION (VERIFYING STANDARD CELL S0 LOGIC) ===
  echo ==========================================================================

  * Tap 0: s = 00000 (Target: 0.0 dB / 1x)
  alterparam v_s0=0
  alterparam v_s1=0
  alterparam v_s2=0
  alterparam v_s3=0
  alterparam v_s4=0
  reset
  op
  let s0_dc0 = v(x1.S0)
  ac dec 10 1k 100Meg
  let gain0 = db(v(VOUT)/v(VIN))
  let g0_val = gain0[10]
  echo Tap 0 (s=00000): S0 DC = $&s0_dc0 V | AC Gain @ 10kHz = $&g0_val dB (Target: 0.00 dB)

  * Tap 1: s = 00001 (Target: 6.02 dB / 2x)
  alterparam v_s0=1.2
  alterparam v_s1=0
  alterparam v_s2=0
  alterparam v_s3=0
  alterparam v_s4=0
  reset
  op
  let s0_dc1 = v(x1.S0)
  ac dec 10 1k 100Meg
  let gain1 = db(v(VOUT)/v(VIN))
  let g1_val = gain1[10]
  echo Tap 1 (s=00001): S0 DC = $&s0_dc1 V | AC Gain @ 10kHz = $&g1_val dB (Target: 6.02 dB)

  * Tap 2: s = 00010 (Target: 12.04 dB / 4x)
  alterparam v_s0=0
  alterparam v_s1=1.2
  alterparam v_s2=0
  alterparam v_s3=0
  alterparam v_s4=0
  reset
  op
  let s0_dc2 = v(x1.S0)
  ac dec 10 1k 100Meg
  let gain2 = db(v(VOUT)/v(VIN))
  let g2_val = gain2[10]
  echo Tap 2 (s=00010): S0 DC = $&s0_dc2 V | AC Gain @ 10kHz = $&g2_val dB (Target: 12.04 dB)

  * Tap 3: s = 00100 (Target: 18.06 dB / 8x)
  alterparam v_s0=0
  alterparam v_s1=0
  alterparam v_s2=1.2
  alterparam v_s3=0
  alterparam v_s4=0
  reset
  op
  let s0_dc3 = v(x1.S0)
  ac dec 10 1k 100Meg
  let gain3 = db(v(VOUT)/v(VIN))
  let g3_val = gain3[10]
  echo Tap 3 (s=00100): S0 DC = $&s0_dc3 V | AC Gain @ 10kHz = $&g3_val dB (Target: 18.06 dB)

  * Tap 4: s = 01000 (Target: 24.08 dB / 16x)
  alterparam v_s0=0
  alterparam v_s1=0
  alterparam v_s2=0
  alterparam v_s3=1.2
  alterparam v_s4=0
  reset
  op
  let s0_dc4 = v(x1.S0)
  ac dec 10 1k 100Meg
  let gain4 = db(v(VOUT)/v(VIN))
  let g4_val = gain4[10]
  echo Tap 4 (s=01000): S0 DC = $&s0_dc4 V | AC Gain @ 10kHz = $&g4_val dB (Target: 24.08 dB)

  * Tap 5: s = 10000 (Target: 30.10 dB / 32x)
  alterparam v_s0=0
  alterparam v_s1=0
  alterparam v_s2=0
  alterparam v_s3=0
  alterparam v_s4=1.2
  reset
  op
  let s0_dc5 = v(x1.S0)
  ac dec 10 1k 100Meg
  let gain5 = db(v(VOUT)/v(VIN))
  let g5_val = gain5[10]
  echo Tap 5 (s=10000): S0 DC = $&s0_dc5 V | AC Gain @ 10kHz = $&g5_val dB (Target: 30.10 dB)

  echo ==========================================================================
  echo === CHARACTERIZATION COMPLETE ===
  echo ==========================================================================
.endc


**** end user architecture code
**.ends

