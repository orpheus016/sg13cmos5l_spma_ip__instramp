# Project xschemrc for ota_cmos5l (used by CACE to netlist the DUT)
# Source the PDK xschemrc file
if {![info exists PDK]} {
    source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
}

# Add current directory and dependencies
set _here [file dirname [file normalize [info script]]]
append XSCHEM_LIBRARY_PATH :$_here
append XSCHEM_LIBRARY_PATH :$_here/../tgate
append XSCHEM_LIBRARY_PATH :$_here/../gain_ota
append XSCHEM_LIBRARY_PATH ://libs.tech/xschem/sg13cmos5l_stdcells
append XSCHEM_LIBRARY_PATH ://libs.ref/sg13cmos5l_stdcell/sch/xschem
