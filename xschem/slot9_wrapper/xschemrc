# slot9_wrapper xschemrc (used by scripts/run_lvs.sh for xschem/slot9_wrapper; instantiates pgia_top)
if {![info exists PDK]} {
    set PDK ihp-sg13cmos5l
}
if {![info exists env(PDK)]} {
    set env(PDK) $PDK
}
if {![info exists env(PDK_ROOT)]} {
    set env(PDK_ROOT) /foss/pdks
}
source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc

set _here [file dirname [file normalize [info script]]]
append XSCHEM_LIBRARY_PATH :$_here
