osdi /foss/pdks/ihp-sg13cmos5l/libs.tech/ngspice/osdi/r3_cmc.osdi
osdi /foss/pdks/ihp-sg13cmos5l/libs.tech/ngspice/osdi/mosvar.osdi
osdi /foss/pdks/ihp-sg13cmos5l/libs.tech/ngspice/osdi/cap_cmomi.osdi
osdi /foss/pdks/ihp-sg13cmos5l/libs.tech/ngspice/osdi/cap_cmomf.osdi
