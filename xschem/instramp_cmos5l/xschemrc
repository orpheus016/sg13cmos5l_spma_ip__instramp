# Project xschemrc for instramp_cmos5l (used by CACE to netlist the DUT)
# Source the PDK xschemrc file
if {![info exists PDK]} {
    source $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
}

# Add current directory (instramp_cmos5l.sym / .sch) and the OTA it is built from (ota_cmos5l.sym / .sch)
set _here [file dirname [file normalize [info script]]]
append XSCHEM_LIBRARY_PATH :$_here
append XSCHEM_LIBRARY_PATH :$_here/../ota_cmos5l
